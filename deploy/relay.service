[Unit]
Description=ai-ops-relay (HTTPS + SSH multiplexer)
Documentation=https://github.com/runzebra01-cmd/ai-ops-relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=relay
Group=relay
EnvironmentFile=/etc/relay/relay.env
ExecStart=/usr/local/bin/relay serve \
  -addr 0.0.0.0:443 \
  -policy /etc/relay/policy.json \
  -audit /var/log/relay/audit.jsonl \
  -tls-cert /etc/relay/cert.pem \
  -tls-key /etc/relay/key.pem \
  -ssh-proxy 127.0.0.1:22 \
  -api-token ${RELAY_API_TOKEN} \
  -agents ${RELAY_AGENTS}
Restart=always
RestartSec=2

# 443 需要绑定特权端口；其余沙箱限制按需调整
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/log/relay /var/lib/relay

[Install]
WantedBy=multi-user.target

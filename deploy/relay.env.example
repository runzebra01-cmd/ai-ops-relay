# 复制为 /etc/relay/relay.env，并 chmod 600。
# 这些值都是占位符，请用 `openssl rand -hex 16` 自己生成，不要提交到仓库。

# 控制面 API 令牌（MCP / curl / 控制台使用）
RELAY_API_TOKEN=replace-with-openssl-rand-hex-16

# 每台 agent 一个独立令牌，格式 host=token，逗号分隔
RELAY_AGENTS=intranet-01=replace-with-another-token,vps=replace-with-a-third-token

# 可选：安装包下载令牌；留空则不启用 /dl/ 下载
RELAY_DOWNLOAD_TOKEN=replace-with-download-token
